<Page x:Class="_12prak.Pages.GroupForm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_12prak.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GroupForm">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="10">
            <Label FontWeight="Bold">Название группы</Label>
            <TextBox Text="{Binding Title}" Margin="0,5,0,15" Height="30"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Click="save" Content="Сохранить" Width="100" Margin="5" Padding="5"/>
                <Button Click="back" Content="Назад" Width="100" Margin="5" Padding="5"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10">
            <Label FontWeight="Bold" FontSize="14">Студенты группы</Label>
            <ListView ItemsSource="{Binding Students}" MaxHeight="400">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Text="{Binding Name}"/>
                                <TextBlock Foreground="Gray" Text="{Binding Login}"/>
                                <TextBlock Foreground="Gray" Text="{Binding Email}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>