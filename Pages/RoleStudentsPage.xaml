<Page x:Class="_12prak.Pages.RoleStudentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_12prak.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RoleStudentsPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Click="back" Content="Назад" Width="100" Margin="5"/>

        <ListView Grid.Row="1" ItemsSource="{Binding Students}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border >
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text="{Binding Login}"/>
                            <TextBlock Text="{Binding Email}"/>
                            <TextBlock>
                                <Run Text="Группа: "/>
                                <Run Text="{Binding Group.Title}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>