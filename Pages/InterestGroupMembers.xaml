<Page x:Class="_12prak.Pages.InterestGroupMembers"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:_12prak.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="InterestGroupMembers">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Click="back" Content="Назад" Width="80" Margin="5"/>
            <Button Click="addUser" Content="Добавить пользователя" Width="180" Margin="5"/>
            <Button Click="removeUser" Content="Удалить из группы" Width="150" Margin="5"/>
        </StackPanel>

        <ListView Grid.Row="1"
                  ItemsSource="{Binding Members}"
                  SelectedItem="{Binding current}"
                  Margin="5">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="14" FontWeight="Bold"
               Text="{Binding User.Name}"/>
                                <TextBlock FontSize="18"       Text="  Модератор">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsModerator}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Foreground="Gray" FontSize="12">
                                <Run Text="Логин: "/>
                                <Run Text="{Binding User.Login}"/>
                            </TextBlock>
                            <TextBlock Foreground="Gray" FontSize="12">
                                <Run Text="Email: "/>
                                <Run Text="{Binding User.Email}"/>
                            </TextBlock>
                            <TextBlock Foreground="Gray" FontSize="12">
                                <Run Text="Телефон: "/>
                                <Run Text="{Binding User.UserProfile.Phone}"/>
                            </TextBlock>
                            <TextBlock Foreground="Gray" FontSize="12">
                                <Run Text="Дата вступления: "/>
                                <Run Text="{Binding JoinedAt, StringFormat={}{0:dd.MM.yyyy}}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>