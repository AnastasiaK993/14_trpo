<Page x:Class="_12prak.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_12prak.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
  DataContext="{Binding RelativeSource={RelativeSource Self}}"
Title="MainPage">
   
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Padding="5" Margin="5" Click="go_form">Добавить</Button>
            <Button Padding="5" Margin="5" Click="remove">Удалить</Button>
            <Button Padding="5" Margin="5" Click="Edit">Изменить</Button>
            <Button Padding="5" Margin="5" Click="go_to_groups">Группы</Button>
            <Button Padding="5" Margin="5" Click="go_to_roles">Роли</Button>
            <Button Padding="5" Margin="5" Click="editProfile">Профиль</Button>
            <Button Padding="5" Margin="5" Click="go_to_interest_groups">Группы интересов</Button>
        </StackPanel>
        <ListView Grid.Row="1"
ItemsSource="{Binding service.Students}"
MouseDoubleClick="Edit"
SelectedItem="{Binding student}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel>

                            <!--//Id - идентификатор, целочисленный тип данных
                //Login - логин пользователя
                //Name - имя пользователя
                //Email - электронная почта
                //Password - пароль пользователя
                //CreatedAt - дата и время создания пользователя(поле CreatedAt добавить отдельной миграцией)-->
                            <TextBlock Text="{Binding Login}"/>
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text="{Binding Email}"/>
                            <TextBlock Text="{Binding Password}"/>
                            <TextBlock>
                                <Run Text="Роль: "/>
                                <Run Text="{Binding Role.Title}"/>
                            </TextBlock>
                            
                            <TextBlock Text="{Binding CreatedAt, StringFormat=
{}{0:dd.MM.yyyy}}"/>
                            <TextBlock>Паспорт</TextBlock>
                            <TextBlock>
                <Run Text="Серия: "/>
                <Run Text="{Binding Passport.Series}"/>
                <Run Text="Номер: "/>
                <Run Text="{Binding Passport.Number}"/>
                            </TextBlock>
                            <TextBlock>
    <Run Text="Телефон: "/>
    <Run Text="{Binding UserProfile.Phone}"/>
                            </TextBlock>
                            <TextBlock>
    <Run Text="Дата рождения: "/>
    <Run Text="{Binding UserProfile.Birthday, StringFormat={}{0:dd.MM.yyyy}}"/>
                            </TextBlock>
                            <TextBlock>
<Run Text="Группа: "/>
<Run Text="{Binding Group.Title}"/>
                            </TextBlock>
                            <TextBlock>
 
    <Run Text="Дата вступления: "/>
    <Run Text="{Binding UserProfile.EnrollmentDate, StringFormat={}{0:dd.MM.yyyy}}"/>

                            </TextBlock>

                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
