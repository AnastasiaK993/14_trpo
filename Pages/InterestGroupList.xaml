<Page x:Class="_12prak.Pages.InterestGroupList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:_12prak.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      Title="InterestGroupList">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Click="back" Content="Назад" Width="80" Margin="5"/>
            <Button Click="add" Content="Добавить" Width="80" Margin="5"/>
            <Button Click="edit" Content="Изменить" Width="80" Margin="5"/>
            <Button Click="remove" Content="Удалить" Width="80" Margin="5"/>
            <Button Click="viewMembers" Content="Участники" Width="100" Margin="5"/>
        </StackPanel>

        <ListView Grid.Row="1"
                  ItemsSource="{Binding service.InterestGroups}"
                  MouseDoubleClick="edit"
                  SelectedItem="{Binding current}"
                  Margin="5">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="5">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="Bold">
                                <Run Text="Группа: "/>
                                <Run Text="{Binding Title}"/>
                            </TextBlock>
                            <TextBlock Foreground="Gray" FontSize="12">
                                <Run Text="{Binding Description}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>