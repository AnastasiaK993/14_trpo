<Page x:Class="_12prak.Pages.UserProfileForm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_12prak.Pages"
             xmlns:validation="clr-namespace:_12prak.ValidationRules"
     xmlns:services="clr-namespace:_12prak"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="UserProfileForm">
    <Page.Resources>
        <validation:passwordValidationRule x:Key="passwordValidationRule"/>
        <validation:loginValidationRule x:Key="loginValidationRule"/>
        <validation:voidValidationRule x:Key="voidValidationRule"/>
        <validation:emailValidationRule x:Key="emailValidationRule"/>
        <services:GroupsService x:Key="gService"/>
        <services:RolesService x:Key="rService"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <StackPanel>
                <StackPanel>
                    <Label>Роль</Label>
                    <ComboBox ItemsSource="{Binding Source={StaticResource rService}, Path=Roles}"
            DisplayMemberPath="Title"
            SelectedItem="{Binding Role}"/>
                </StackPanel>
                <StackPanel>
                    <Label Content="Аватар (URL)" FontWeight="Bold"/>
                    <TextBox x:Name="AvatarBox" Margin="0,5,0,10">
                        <TextBox.Text>
                            <Binding Path="UserProfile.AvatarUrl" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True">
                                <Binding.ValidationRules>
                                    <validation:voidValidationRule ValidatesOnTargetUpdated="True"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>

                    <Label Content="Телефон" FontWeight="Bold"/>
                    <TextBox x:Name="PhoneBox" Margin="0,5,0,10">
                        <TextBox.Text>
                            <Binding Path="UserProfile.Phone" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True">
                                <Binding.ValidationRules>
                                    <validation:voidValidationRule ValidatesOnTargetUpdated="True"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>

                    <Label Content="Дата рождения" FontWeight="Bold"/>
                    <DatePicker SelectedDate="{Binding UserProfile.Birthday}" Margin="0,5,0,10"/>

                    <Label Content="О себе" FontWeight="Bold"/>
                    <TextBox x:Name="BioBox" Height="100" TextWrapping="Wrap" 
                     AcceptsReturn="True" Margin="0,5,0,10">
                        <TextBox.Text>
                            <Binding Path="UserProfile.Bio" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True">
                                <Binding.ValidationRules>
                                    <validation:voidValidationRule ValidatesOnTargetUpdated="True"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>

                    <Label Content="Дата вступления" FontWeight="Bold"/>
                    <DatePicker  SelectedDate="{Binding UserProfile.EnrollmentDate}" />

                </StackPanel>
                <Button Click="save" Content="Сохранить">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=PhoneBox, Path=(Validation.HasError)}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=AvatarBox, Path=(Validation.HasError)}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=BioBox, Path=(Validation.HasError)}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Click="back">Назад</Button>

                <Label Content="Группы интересов"  />
                <ListView x:Name="UserGroupsList" Height="200">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5">
                                <StackPanel>
                                    <TextBlock  FontSize="14"
                                           Text="{Binding InterestGroup.Title}"/>
                                    <TextBlock FontSize="12" >
                                    <Run Text="Дата вступления: "/>
                                    <Run Text="{Binding JoinedAt, StringFormat={}{0:dd.MM.yyyy}}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" >
                                    <Run Text="Модератор: "/>
                                    <Run Text="{Binding IsModerator}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--<TextBlock>
                    <Run Text="Имя: "/>
                    <Run Text="{Binding Student.Name}" />
                </TextBlock>
                <TextBlock>
                    <Run Text="Логин: "/>
                    <Run Text="{Binding Student.Login}"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="Email: "/>
                    <Run Text="{Binding Student.Email}"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="Роль: "/>
                    <Run Text="{Binding Student.Role.Title}"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="Группа: "/>
                    <Run Text="{Binding Student.Group.Title}"/>
                </TextBlock>-->



            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>