<Page x:Class="_12prak.Pages.InterestGroupForm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:_12prak.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="InterestGroupForm">

    <Grid Margin="10">
        <StackPanel>
            <Label FontWeight="Bold" FontSize="16">Название группы</Label>
            <TextBox Text="{Binding Title}" Margin="0,5,0,15" Height="30"/>

            <Label FontWeight="Bold" FontSize="16">Описание</Label>
            <TextBox Text="{Binding Description}"
                     Margin="0,5,0,15"
                     Height="100"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Click="save" Content="Сохранить" Width="100" Margin="5" Padding="5"/>
                <Button Click="back" Content="Назад" Width="100" Margin="5" Padding="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>