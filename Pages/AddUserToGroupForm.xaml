<Page x:Class="_12prak.Pages.AddUserToGroupForm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:_12prak.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="600"
      Title="AddUserToGroupForm">

    <Grid Margin="10">
        <StackPanel>
            <Label FontWeight="Bold" FontSize="16">Добавить в группу:</Label>
            <Label Content="{Binding GroupTitle}" FontSize="14" Margin="0,0,0,15"/>

            <Label>Пользователь</Label>
            <ComboBox x:Name="UserBox" DisplayMemberPath="Name" Margin="0,5,0,15" Height="30"/>

            <Label>Роль в группе</Label>
            <ComboBox x:Name="RoleBox" Margin="0,5,0,15" Height="30">
                <ComboBoxItem Content="Обычный участник" IsSelected="True"/>
                <ComboBoxItem Content="Модератор"/>
            </ComboBox>

            <Label>Дата вступления</Label>
            <DatePicker x:Name="JoinedAtPicker" Margin="0,5,0,15" Height="30"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Click="save" Content="Записать" Width="120" Margin="5" Padding="5"/>
                <Button Click="back" Content="Назад" Width="120" Margin="5" Padding="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>